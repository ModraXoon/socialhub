# Copy to brands/<slug>.env (e.g. brands/mybrand.env). Leave a network empty to disable it.
NAME=

# Meta: Facebook Page + Instagram professional account linked to it.
# Fill META_APP_ID, META_APP_SECRET, META_USER_TOKEN, then run: npm run setup:meta -- <slug>
META_APP_ID=
META_APP_SECRET=
META_USER_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=
IG_USER_ID=

# Threads: add the "Threads API" use case to the Meta app, add the account as Threads tester,
# generate a token in the use case's User Token Generator, then: npm run auth:threads -- <slug>
THREADS_TOKEN=
THREADS_LINK=

# TikTok (desktop app, redirect URI http://127.0.0.1:3455/callback/). Fill key + secret, then: npm run auth:tiktok -- <slug>
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube Data API v3 (OAuth desktop client). Run: npm run auth:youtube -- <slug>
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
