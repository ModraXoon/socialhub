# Global settings. Copy to .env. Per-brand account keys live in brands/<slug>.env.
PORT=4310

# Keep DRY_RUN=1 until each brand's accounts are configured and tested.
# In dry-run nothing is posted anywhere; publishing is only simulated and logged.
DRY_RUN=1

GRAPH_VERSION=v26.0

# Temporary public hosting for media (Instagram/Facebook/Threads fetch media by URL).
# Files go to a private bucket, Meta gets a 1-hour signed link, files are deleted after publishing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_BUCKET=social-temp
