{
  "name": "socialhub",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-brand social media scheduler (Instagram, Facebook Page, Threads, TikTok, YouTube)",
  "type": "module",
  "scripts": {
    "start": "node --no-warnings server.mjs",
    "auth:youtube": "node --no-warnings auth-youtube.mjs",
